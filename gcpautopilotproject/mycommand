name: CI/CD Pipeline
on:
  push:
    branches:
      - branch-name
  pull_request:
    branches:
      - branch-name
  workflow_dispatch:
jobs:
  build:
    runs-on: runner-name
    outputs:
      tag: ${{ steps.date.outputs.image_tag }}

    env:
      GAR_LOCATION: "us-central1"
      PROJECT_ID: ""
      REPOSITORY: ""
      DOCKER_REPOSITORY: 
      DEPLOYMENT_NAME: ''
      IMAGE_NAME: 
      SPRING_PROFILES_ACTIVE: 'stg' # Set your Spring profile as 'dev'
      RUNTIME_VERSION: "4.6.7"
    strategy:
      fail-fast: false
      matrix:
        language: ['java']
    steps:
      - name: "Checkout repository"
        uses: actions/checkout@v4

      - name: Get current date
        id: date
        run: |
          BRANCH_NAME=${GITHUB_REF_NAME}
          SAN_BRANCH=$(echo "$BRANCH_NAME" | tr '/' '-')
          echo "image_tag=$SAN_BRANCH"_"$(date +%Y-%m-%d_%H-%M)" >> $GITHUB_OUTPUT

      - name: "Run static code analysis"
        run: |
          echo "Analyzing Java code..."

      - name: "Set up Java 17"
        uses: actions/setup-java@v4
        with:
          java-version: '17'
          distribution: 'temurin'
          architecture: x64

      - name: "Cache Maven packages"
        uses: actions/cache@v3
        with:
          path: ~/.m2/repository
          key: ${{ runner.os }}-maven-${{ hashFiles('**/pom.xml') }}
          restore-keys: |
            ${{ runner.os }}-maven-
     # - name: "Set up Maven"
     #   uses: stCarolas/setup-maven@v5
     #   with:
     #     maven-version: 3.8.6

     # - name: "Maven Quality Scan"
     #   uses: /maven-build-scan@v1
     #   with:
     #     sonar-token: ${{ secrets.SONAR_TOKEN }}
     #     enable-codeql: false
