name: 'Terraform Deployment'

on:
  push:
    branches: [ "branch name" ]
  pull_request:
    branches: [ "branch name" ]

permissions:
  contents: read

jobs:
  terraform:
    name: 'Terraform Execution'
    runs-on: { group: runner-name }
    environment: prod

    defaults:
      run:
        shell: bash

    steps:
      - name: Checkout Repository
        uses: actions/checkout@v4  

      - name: Setup Terraform
        uses: hashicorp/setup-terraform@v1
        with:
          cli_config_credentials_token: ${{ secrets.TF_API_TOKEN }}

      - name: Debug Directory Structure
        run: |
          echo "Listing files..."
          ls -R
          echo "Checking if prod directory exists..."
          [ -d "prod/" ] && echo "Directory exists" || echo "Directory NOT found"

      - name: Run Terraform Commands for the GCP infra
        if: success()
        working-directory: environments/prod
        run: |
          terraform init
          terraform validate
          terraform refresh -lock=false
          terraform fmt
          terraform plan -lock=false
        env:
          GOOGLE_CREDENTIALS: ${{ secrets.SA_KEY }}

