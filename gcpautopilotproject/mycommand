      #       }}/bne-artifact-registry/${{ env.IMAGE_NAME }}:latest
      #     password: ${{ secrets.SVC_BUILD_PWD }}


      - name: "Upload Build Artifact"
        uses: actions/upload-artifact@v4
        with:
          name: build-artifact
          path: target/*.jar
          if-no-files-found: warn


  deploy-dev:
     runs-on: runner name
     needs: [ build]
     steps:
       - name: "Checkout repository"
         uses: actions/checkout@v4

       - name: "Apply Dev Deployment"
         run: |
           sed -i "s|image: us-central1-docker.pkg.dev/project-name/artifact-registry/image name:.*|image: us-central1-docker.pkg.dev/project-id/artifact-registry/image:${{ needs.build.outputs.tag }} | g" infrastructure/deployment.yml
           cat infrastructure/deployment.yml

       - name: 'Authenticate to Google Cloud'
         uses: google-github-actions/auth@v2
         with:
           credentials_json: '${{ secrets.SA_KEY }}'

       - name: 'Set up GCP SDK'
         uses: google-github-actions/setup-gcloud@v2

       - name: "Set GKE credentials"
         run: |
           gcloud components install gke-gcloud-auth-plugin
           gcloud container clusters get-credentials cluster-name --region us-central1 --project project-id

       - name: "Deploy to GKE"
         run: |
           cd infrastructure/dev
           kubectl apply -f pvc.yml -n namespace-name
           kubectl apply -f deployment.yml -n namespace-name
           kubectl apply -f service.yml -n namespace-name

