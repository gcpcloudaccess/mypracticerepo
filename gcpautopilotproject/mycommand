#This setup will create a Cloud SQL instance, databases with the super user and password stored securely in GCP Secret Manager.

provider "google" {
  project = var.project_id
  region  = var.region
}

resource "google_project_service" "cloud_sql_admin_api" {
  project = var.project_id
  service = "sqladmin.googleapis.com"
}


resource "google_sql_database_instance" "sql_instance" {
  name                = var.instance_name
  database_version    = var.database_version
  region              = var.region
  deletion_protection = true

  settings {
    tier = var.instance_tier
    edition = var.edition # "ENTERPRISE_PLUS"
    availability_type = var.availability_type  # Enable HA
    #     memory            = 200 * 1024 * 1024 * 1024

    backup_configuration {
      enabled                           = var.backup_configuration.enabled
      start_time                        = var.backup_configuration.start_time
      binary_log_enabled                = var.backup_configuration.binary_log_enabled
      location                          = "us"
    }

    data_cache_config {
      data_cache_enabled = true
    }

    ip_configuration {
      ipv4_enabled = false
      ssl_mode    = "ENCRYPTED_ONLY"

      psc_config {
        psc_enabled = true
        allowed_consumer_projects = var.allowed_consumer_projects
      }

    }
    database_flags {
      name  = "lower_case_table_names"
      value = "1"
    }


  }
}


# Create databases
resource "google_sql_database" "databases" {
  count = length(var.database_name)
  name     = var.database_name[count.index]
  instance = google_sql_database_instance.sql_instance.name
}

resource "google_sql_user" "db_users" {
  name     = var.db_users
  instance = google_sql_database_instance.sql_instance.name
}

