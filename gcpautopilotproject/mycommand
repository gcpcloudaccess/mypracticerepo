     #     maven-sonar-command: "-DskipTests=true --file ./pom.xml -B verify org.sonarsource.scanner.maven:sonar-maven-plugin:sonar -Dmaven.repo.local=/home/runner/.m2/repository"
     #   env:
     #     SONAR_TOKEN: ${{ secrets.SONAR_TOKEN }}
      - name: Set up Maven
        uses: stCarolas/setup-maven@v4.5
        with:
            maven-version: 3.8.2
    
      - name: Initialize CodeQL
        uses: github/codeql-action/init@v3
        with:
          languages: ${{ matrix.language }}
            # CodeQL supports [ 'cpp', 'csharp', 'go', 'java', 'javascript', 'python' ]
            # Learn more about CodeQL language support at https://aka.ms/codeql-docs/language-support
          queries: security-extended,security-and-quality

      - name: Autobuild
        uses: github/codeql-action/autobuild@v2
        
      - name: 'Authenticate to Google Cloud'
        uses: google-github-actions/auth@v2
        with:
          credentials_json: '${{ secrets.SA_KEY }}'

      - name: 'Set up GCP SDK'
        uses: google-github-actions/setup-gcloud@v2

      - name: 'Configure Docker for GCP'
        run: |
          gcloud auth configure-docker ${{ env.GAR_LOCATION }}-docker.pkg.dev
        shell: bash

      # Dynamically set image tag using Git SHA
      - name: 'Set image tag'
        id: tag
        run: |
          export IMAGE_TAG=${GITHUB_SHA::8}  # Use first 8 characters of commit hash
          echo "image_tag=$IMAGE_TAG" >> $GITHUB_OUTPUT
      - name: "Build Docker image"
        run: |
          docker build -t us-central1-docker.pkg.dev/${{ env.PROJECT_ID }}/registry-name/image-name:${{ steps.date.outputs.image_tag }} .
          docker push us-central1-docker.pkg.dev/${{ env.PROJECT_ID }}/registry-name/image-name:${{ steps.date.outputs.image_tag }}

